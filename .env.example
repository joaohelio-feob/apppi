# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional — integração somente leitura com o GitHub (página /codigo).
# Sem essas três, a página degrada com um aviso em vez de quebrar.
# Gere um fine-grained token em github.com/settings/tokens, só com permissão
# de leitura (Contents, Pull requests, Issues, Checks) no repositório da
# equipe. NUNCA prefixe com NEXT_PUBLIC_ — o token não pode chegar no navegador.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
GITHUB_ORG=nome-da-organizacao
GITHUB_REPO=nome-do-repositorio
